        return false;
    }

    @Override
    public boolean isServerInitializable() {
        return true;
    }

    @Override
    public boolean isClientInitializable() {
        return true;
    }

    @Override
    public boolean isServerModifiable(@NonNull State state) {
        // PRE_ACTIVE is modifiable by default, adjust as needed
        return state.getValue().getValue() == State.Standard.PRE_ACTIVE.getValue();
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;
        {{ATTRIBUTE_NAME}} that = ({{ATTRIBUTE_NAME}}) o;
        // Compare OffsetDateTime up to seconds to avoid flakiness
        return this.{{FIELD_NAME}}.withNano(0).equals(that.{{FIELD_NAME}}.withNano(0));
    }

    @Override
    public int hashCode() {
        return Objects.hash({{FIELD_NAME}}.withNano(0));
    }
