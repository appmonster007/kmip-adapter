        {{FIELD_TYPE}} value = p.getCodec().treeToValue(valueNode, {{FIELD_TYPE}}.class);
        {{ATTRIBUTE_NAME}} {{ATTRIBUTE_VAR}} = {{ATTRIBUTE_NAME}}.builder().value(value).build();

