    @Override
    protected void assertEnumerationRegistryBehavior() {
        // TODO: Customize these assertions based on actual enum values and expected registry behavior
        // Valid registration in {{ATTRIBUTE_NAME}} requires 8XXXXXXX (hex) range per implementation
        {{ATTRIBUTE_NAME}}.Value custom = {{ATTRIBUTE_NAME}}.register(0x80000010, "X-Enum-Custom", Set.of(KmipSpec.UnknownVersion));
        assertThat(custom.isCustom()).isTrue();
        assertThat(custom.getDescription()).isEqualTo("X-Enum-Custom");

        withKmipSpec(KmipSpec.UnknownVersion, () -> {
            assertThat(custom.isSupported()).isTrue();
        });
        withKmipSpec(KmipSpec.UnsupportedVersion, () -> {
            assertThat(custom.isSupported()).isFalse();
        });

        // Negative cases: invalid range, empty description, empty versions
        assertThatThrownBy(() -> {{ATTRIBUTE_NAME}}.register(0x7FFFFFFF, "Bad-Range", Set.of(KmipSpec.UnknownVersion)))
