        assertThatThrownBy(() -> {{ATTRIBUTE_NAME}}.register(0x00000001, "Bad-Range", Set.of(KmipSpec.UnknownVersion)))
                .isInstanceOf(IllegalArgumentException.class);
        assertThatThrownBy(() -> {{ATTRIBUTE_NAME}}.register(0x80000011, "   ", Set.of(KmipSpec.UnknownVersion)))
                .isInstanceOf(IllegalArgumentException.class);
        assertThatThrownBy(() -> {{ATTRIBUTE_NAME}}.register(0x80000012, "X-Empty-Versions", Set.of()))
