    {
      "id": "BUG-001",
      "severity": "P0",
      "title": "AttributeName only registered for V1.1/V1.2; all V2.1/V3.0 attribute constructors will throw",
      "file": "src/main/java/org/purpleBean/kmip/model/core/type/AttributeName.java",
      "line": 18,
      "details": "supportedVersions = Set.of(KmipSpec.UnknownVersion, KmipSpec.V1_1, KmipSpec.V1_2). Every v2.1/v3.0 KmipAttribute implementation calls getAttributeName() which calls AttributeName.of() which calls validate() which throws IllegalArgumentException when spec is V2_1 or V3_0.",
      "fix": "Add KmipSpec.V2_1 and KmipSpec.V3_0 to supportedVersions, OR suppress AttributeName construction in v2.0+ attribute types since the concept is deprecated post-v1.x."
    },
    {
